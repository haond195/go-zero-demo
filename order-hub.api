syntax = "v1"

info (
	title:   "Order Hub API"
	desc:    "Du an demo chuan chi go-zero tich hop 7 components"
	version: "v1.0"
)

type CreateOrderReq {
	CustomerName string  `json:"customer_name" validate:"required,min=2,max=50"`
	Email        string  `json:"email" validate:"required,email"`
	ProductCode  string  `json:"product_code" validate:"required"`
	Quantity     int64   `json:"quantity" validate:"required,gte=1,lte=100"`
	Amount       float64 `json:"amount" validate:"required,gt=0"`
}

type CreateOrderResp {
	OrderId string `json:"order_id"`
	Status  string `json:"status"`
	Message string `json:"message"`
}

type GetOrderReq {
	OrderId string `path:"order_id"`
}

type GetOrderResp {
	OrderId      string  `json:"order_id"`
	CustomerName string  `json:"customer_name"`
	ProductCode  string  `json:"product_code"`
	Quantity     int64   `json:"quantity"`
	Amount       float64 `json:"amount"`
	Status       string  `json:"status"`
}

@server (
	prefix:     /api/v1
	middleware: AuditLog
)
service orderhub-api {
	@handler CreateOrder
	post /orders (CreateOrderReq) returns (CreateOrderResp)

	@handler GetOrder
	get /orders/:order_id (GetOrderReq) returns (GetOrderResp)
}

